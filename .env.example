# Neon - connection string POOLED (usada por la app en runtime, incluye -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Neon - connection string DIRECTA (usada por la CLI de Prisma: migraciones, db push, studio)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Opcional: solo si prisma migrate dev no puede crear la shadow database.
# Apuntarlo a una branch de Neon.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Actor de desarrollo: permite elegir con que usuario se simula estar logueado.
# Habilitado por defecto fuera de produccion. Poner en "1" solo si hace falta
# habilitarlo en un build de produccion. Nunca en un deploy real.
# SIGMED_DEV_ACTOR=1

# Nunca subir el .env real al repositorio.
